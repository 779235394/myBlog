#valine-vuepress-comment {
    max-width: 860px;
    margin: 0 auto;
    padding: 2rem 2.5rem;
}

.footer {
    &>span:nth-child(1) {  
        display:none
    }
}

.abstract-item:hover,.info-wrapper:hover{
    box-shadow: 0 0 16px -1px #ff9cc0 !important;
    transform:scale(1.01);
}


.abstract-item{
  border: 0;
  background: none;
  text-transform: uppercase;
  color: #ff9cc0;
  font-weight: bold;
  position: relative;
  outline: none;
  padding: 10px 20px;
  box-sizing: border-box;
}

.abstract-item::before, .abstract-item::after {
  box-sizing: inherit;
  position: absolute;
  content: '';
  border: 2px solid transparent;
  width: 0;
  height: 0;
}

.abstract-item::after {
  bottom: 0;
  right: 0;
}

.abstract-item::before {
  top: 0;
  left: 0;
}

.abstract-item:hover::before, .abstract-item:hover::after {
  width: 100%;
  height: 100%;
}

.abstract-item:hover::before {
  border-top-color: #ff9cc0;
  border-right-color: #ff9cc0;
  transition: width 0.3s ease-out, height 0.3s ease-out 0.3s;
}

.abstract-item:hover::after {
  border-bottom-color: #ff9cc0;
  border-left-color: #ff9cc0;
  transition: border-color 0s ease-out 0.6s, width 0.3s ease-out 0.6s, height 0.3s ease-out 1s;
}


